.{
    .name = .fluent,
    .version = "0.2.0",
    .fingerprint = 0x8d467dc1f396f537, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Two dependencies, and only one of them unconditional. The corpora
        // this library is measured against and the CLDR data its tables are
        // generated from are each a project of their own, in `conformance/`
        // and `cldr/`, so that nothing here -- and nothing generated from
        // here -- carries 145 MB that a consumer of the library never reads.
        .datetime = .{
            .url = "git+https://git.jcollie.dev/jeff/zig-datetime.git#0df87931af9eecab4d0fab4f41feddea0852acb6",
            .hash = "datetime-0.0.1-6-va75PLRwCTakG5hoGcVabp39RTiiYy7ZZSTqeEFaPx",
        },
        .zigwin32 = .{
            .url = "https://github.com/marlersoft/zigwin32/archive/fb2645891520f3e99931db17a7eba04057e87e89.tar.gz",
            .hash = "win32-42.0.39-preview-mX5pFc794wMcrMyFgsO1c4csBdowhpiqqwIyN_xjqI5z",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "examples",
        // `build.zig` installs `include/fluent.h` on every build, so a
        // package that fetches this one needs the directory to be in the
        // tarball as much as `src` is.
        "include",
        "src",
        "tests",
        "tools",
        // The two projects of their own. Their manifests are what hold the
        // heavy dependencies; see the comment above.
        "cldr",
        "conformance",
        "LICENSES",
        "REUSE.toml",
        "README.md",
    },
}
